# Copy to .env.local (git-ignored) and fill in from your Supabase project.
# VITE_ variables are bundled into the client; the others never leave this machine.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=
# Personal access token for the agent to apply migrations and auth config (Account > Access Tokens).
SUPABASE_ACCESS_TOKEN=
# Database password chosen at project creation. Only needed for CLI db push; keep it here regardless.
SUPABASE_DB_PASSWORD=
